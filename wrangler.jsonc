{
  "name": "danceswithowls",
  "compatibility_date": "2026-10-21",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker first to facilitate `www` redirection.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "danceswithowls.com",
      "custom_domain": true
    },
    {
      "pattern": "www.danceswithowls.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false
}
